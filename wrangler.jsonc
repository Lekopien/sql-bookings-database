// Cloudflare Worker (free plan) that serves the showcase site at https://sql.lekopien.com
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lekopien-sql",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./site" },
  "routes": [{ "pattern": "sql.lekopien.com", "custom_domain": true }]
}
